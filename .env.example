# Copy to .env (never commit .env) and fill in. Set the same values in Netlify:
# Site configuration → Environment variables.

# MongoDB Atlas → your cluster → Connect → Drivers. Put your database user's password in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, default "portfolio")
MONGODB_DB=portfolio
# Signs the admin login cookie. 32+ random characters, e.g. from: openssl rand -base64 48
ADMIN_SECRET=
# YouTube Data API v3 key (Google Cloud → APIs & Services). Loads each Learning playlist's videos.
YOUTUBE_API_KEY=
