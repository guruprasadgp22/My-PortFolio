# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Make each secret with:  openssl rand -base64 48

# MongoDB Atlas connection string (Atlas → Connect → Drivers), with this server's IP allowed in Network Access
MONGODB_URI=
MONGODB_DB=portfolio

# Signs the admin session cookie (gateway + auth-service). 32+ random characters.
SESSION_SECRET=
# Shared by the gateway and the services so they only accept each other. 32+ random characters, different from above.
INTERNAL_TOKEN=

# The API's own domain, pointed at this server (A record). Caddy gets the HTTPS certificate for it.
API_DOMAIN=api.example.com

# Optional
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
